# ==============================================================================
# RANGMANCH '26 - COLLEGE FESTIVAL & CULTURAL CLUBS MANAGEMENT PLATFORM
# ENVIRONMENT CONFIGURATION (.env / .env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE: MONGODB ATLAS
# ------------------------------------------------------------------------------
# Obtain from MongoDB Atlas -> Connect -> Connect your application -> Driver: Node.js
# Replace <username>, <password>, and cluster domain with your Atlas credentials.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/rangmanch_fest_db?retryWrites=true&w=majority"
MONGODB_DB_NAME="rangmanch_fest_db"

# ------------------------------------------------------------------------------
# 2. IMAGE STORAGE & CDN: CLOUDINARY
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Console Dashboard (https://console.cloudinary.com/)
# Used for storing:
#   - Participant Paytm UPI payment receipt screenshots
#   - Official Paytm QR code banners & poster images
#   - Cultural club event posters & gallery photos
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY: NEXTAUTH.JS
# ------------------------------------------------------------------------------
# Generate a 32-byte secure key with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_32_character_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Custom Super Admin Credentials
# If not set in .env, default credentials work out-of-the-box:
# Email: admin@rangmanchfest.in (or admin@aiimsraebareli.edu.in) | Password: Admin@1234
ADMIN_EMAIL="admin@rangmanchfest.in"
ADMIN_PASSWORD="Admin@1234"

# ------------------------------------------------------------------------------
# 4. FIRST-TIME ADMIN BOOTSTRAP SECRET
# ------------------------------------------------------------------------------
# Used to seed/promote initial super admin account via POST /api/admin/bootstrap
ADMIN_BOOTSTRAP_SECRET="your_custom_admin_bootstrap_secret_token"

# ------------------------------------------------------------------------------
# 5. OPTIONAL: GMAIL SMTP VIA NODEMAILER (Free, zero paid APIs)
# ------------------------------------------------------------------------------
# Generate a 16-character Google App Password from myaccount.google.com -> Security -> App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="fest.cultural.up@gmail.com"
SMTP_PASS="your_16_character_google_app_password"
EMAIL_FROM="Rangmanch UP Cultural Fest <fest.cultural.up@gmail.com>"

# ------------------------------------------------------------------------------
# 6. PUBLIC APPLICATION BRANDING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Rangmanch '26"
NEXT_PUBLIC_APP_TAGLINE="Uttar Pradesh Cultural Festival & Student Societies Confluence"
